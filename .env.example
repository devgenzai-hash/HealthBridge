# HealthBridge Environment Variables
# Copy this file to .env.local and fill in the values

# =============================================================================
# SUPABASE
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# =============================================================================
# AI PROVIDER (pluggable architecture)
# =============================================================================
# Supported: openai | openrouter | nvidia-nim | ollama | llama-cpp | groq | together | anthropic
AI_PROVIDER=openai

# API key for the chosen provider
# For ollama: leave blank or set to "ollama"
AI_API_KEY=

# Optional: override default model for the chosen provider
# Defaults: openai=gpt-4o-mini, openrouter=openai/gpt-4o-mini, nvidia-nim=meta/llama-3.1-70b-instruct
#           ollama=llama3.2, groq=llama-3.3-70b-versatile, together=meta-llama/Llama-3-8b-chat-hf
AI_MODEL=gpt-4o-mini

# Embedding configuration
# Models: text-embedding-3-large (3072d), text-embedding-3-small (1536d), mxbai-embed-large (1024d)
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=3072

# =============================================================================
# APPLICATION
# =============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=HealthBridge

# API routing mode
# false = Next.js /api routes run shared handlers locally
# true = Next.js /api routes proxy to the dedicated Node.js API server
USE_DEDICATED_API=false
DEDICATED_API_BASE_URL=http://localhost:4000

# Dedicated API server settings
API_PORT=4000
API_HOST=0.0.0.0
API_CORS_ORIGIN=http://localhost:3000

# =============================================================================
# EMAIL (Resend)
# =============================================================================
RESEND_API_KEY=

# =============================================================================
# SECURITY
# =============================================================================
# Rate limiting (requests per minute per user for AI endpoints)
AI_RATE_LIMIT_PER_MINUTE=10

# OTP settings
OTP_MAX_ATTEMPTS=5
OTP_LOCKOUT_MINUTES=60
